# ============================================================================
# KERNEL FORGE - MOCK ENVIRONMENT VARIABLES (.env.local)
# ============================================================================
# Replace these values with your actual configuration
# DO NOT commit real credentials to version control
# ============================================================================

# DATABASE - SUPABASE
# Get these from https://supabase.com
# 1. Create a new project
# 2. Copy Project URL → NEXT_PUBLIC_SUPABASE_URL
# 3. Copy anon key → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Copy service_role key → SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...mock...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...mock...

# CLOUDINARY - IMAGE MANAGEMENT
# Get these from https://cloudinary.com
# 1. Sign up / log in
# 2. Go to Dashboard → Settings → API Keys
# 3. Copy Cloud Name, API Key, API Secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789123456789
CLOUDINARY_API_SECRET=AbCdEfGhIjKlMnOpQrStUvWxYz

# GITHUB - PROJECT REPOSITORY SYNC
# Get this from https://github.com/settings/tokens
# 1. Click "Generate new token (classic)"
# 2. Select scopes: repo, read:user, read:org
# 3. Copy token
GITHUB_TOKEN=ghp_1234567890abcdefghijklmnopqrstuvwxyz
GITHUB_ORG=kernel-forge

# EMAIL - RESEND FOR CONTACT FORM & NOTIFICATIONS
# Get this from https://resend.com
# 1. Sign up / log in
# 2. Go to API Keys
# 3. Copy API Key
RESEND_API_KEY=re_1234567890abcdefghijklmnopqrstuvwxyz
ADMIN_EMAIL=admin@kernelforge.dev
CONTACT_EMAIL=contact@kernelforge.dev

# DATABASE SCHEMA - AUTO MIGRATIONS
# Set to true to auto-run migrations on first deploy
SUPABASE_AUTO_MIGRATE=true

# DEVELOPMENT
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PRODUCTION (when deploying)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# FEATURE FLAGS
ENABLE_ADMIN_DASHBOARD=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PROJECT_SYNC=true

# ============================================================================
# DEFAULT ADMIN CREDENTIALS (Change these immediately after first login!)
# ============================================================================
# These credentials are only used during initial Supabase migration
# They will create the default admin, moderator, and test accounts

DEFAULT_ADMIN_EMAIL=admin@kernelforge.dev
DEFAULT_ADMIN_PASSWORD=KernelForge2026!Admin

DEFAULT_MODERATOR_EMAIL=moderator@kernelforge.dev
DEFAULT_MODERATOR_PASSWORD=KernelForge2026!Mod

DEFAULT_TEST_EMAIL=test@kernelforge.dev
DEFAULT_TEST_PASSWORD=KernelForge2026!Test

# ============================================================================
# OPTIONAL - ANALYTICS & MONITORING
# ============================================================================
# VERCEL_ANALYTICS_ID=your-analytics-id
# SENTRY_DSN=your-sentry-dsn

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp .env.local.mock .env.local
# 2. Replace all "your_*" values with real credentials
# 3. Run migrations: npm run db:migrate (if available)
# 4. Start dev server: pnpm dev
# 5. Login at http://localhost:3000/admin
# ============================================================================
