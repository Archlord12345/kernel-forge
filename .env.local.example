# Copier ce fichier en .env.local et renseigner les valeurs.
# Sans ces variables, le site fonctionne avec les données statiques
# (projets, équipe) et le formulaire de contact renvoie une erreur 503.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
